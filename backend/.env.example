# SensorTrust Backend Environment Configuration
# Copy this file to .env for local overrides

ENVIRONMENT=development
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000

# SQLite local development database (relative path or absolute)
DATABASE_URL=sqlite:///./sensortrust.db

# Allowed CORS origins for local frontend development (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Seed database with baseline multi-basin records if empty
SEED_ON_STARTUP=true

# Phase 4 — EVM Blockchain Integration
# Local Hardhat EVM Node Configuration
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Optional: Specific deployed contract address (leave blank for auto-deployment on local node)
# BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Security notice: Keep real private keys OUT of source control and logs.
# For local development with Hardhat node, defaults to Account #0:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# In staging/production, provide an explicit unshared relayer key:
# BLOCKCHAIN_PRIVATE_KEY=your_relayer_private_key_here
BLOCKCHAIN_AUTO_ANCHOR=true

